new file mode 100644
index 000000000..6c6856e5e
--- /dev/null
+++ b/src/burn/drv/cave/cv1k_ps5_profile.h
@@ -0,0 +1,62 @@
+// Bounded phase measurements; CPU phase includes memory/device handlers.
+#ifndef CV1K_PS5_PROFILE_H
+#define CV1K_PS5_PROFILE_H
+#if defined(__PS5__)
+#include <time.h>
+#include <stdio.h>
+#include <errno.h>
+extern "C" void pemu_boot_mark(const char *) __attribute__((weak));
+static UINT64 cvp_start, cvp_last, cvp_total[4];
+static unsigned cvp_frames, cvp_reports;
+static UINT64 cvp_now() {
+    const int saved = errno;
+    struct timespec t;
+    const int rc = clock_gettime(CLOCK_MONOTONIC, &t);
+    errno = saved;
+    return rc ? 0 : (UINT64)t.tv_sec * 1000000 + t.tv_nsec / 1000;
+}
+static void cvp_reset() {
+    cvp_start = cvp_last = 0; cvp_frames = cvp_reports = 0;
+    memset(cvp_total, 0, sizeof(cvp_total));
+}
+static void cvp_load(const char *stage, UINT64 start) {
+    if (!pemu_boot_mark) return;
+    const int saved = errno;
+    char line[180];
+    snprintf(line, sizeof(line), "CV_LOAD game=%s stage=%s us=%llu",
+        BurnDrvGetTextA(DRV_NAME), stage, (unsigned long long)(cvp_now() - start));
+    pemu_boot_mark(line); errno = saved;
+}
+static void cvp_begin() {
+    if (cvp_reports >= 12) return;
+    cvp_last = cvp_now(); if (!cvp_start) cvp_start = cvp_last;
+}
+static void cvp_phase(unsigned phase) {
+    if (cvp_reports >= 12) return;
+    UINT64 now = cvp_now();
+    if (now >= cvp_last) cvp_total[phase] += now - cvp_last;
+    cvp_last = now;
+    if (phase != 3) return;
+    ++cvp_frames;
+    if (now - cvp_start < 5000000) return;
+    const int saved = errno;
+    char line[192];
+    snprintf(line, sizeof(line),
+        "CV_PERF game=%s frames=%u cpu_us=%llu audio_us=%llu sync_us=%llu draw_us=%llu clock=%d dips=%02x",
+        BurnDrvGetTextA(DRV_NAME), cvp_frames,
+        (unsigned long long)(cvp_total[0]/cvp_frames), (unsigned long long)(cvp_total[1]/cvp_frames),
+        (unsigned long long)(cvp_total[2]/cvp_frames), (unsigned long long)(cvp_total[3]/cvp_frames),
+        DriverClock, DrvDips[1]);
+    if (pemu_boot_mark) pemu_boot_mark(line);
+    errno = saved;
+    ++cvp_reports; cvp_frames = 0; cvp_start = now;
+    memset(cvp_total, 0, sizeof(cvp_total));
+}
+#else
+static UINT64 cvp_now() { return 0; }
+static void cvp_reset() {}
+static void cvp_load(const char *, UINT64) {}
+static void cvp_begin() {}
+static void cvp_phase(unsigned) {}
+#endif
+#endif
