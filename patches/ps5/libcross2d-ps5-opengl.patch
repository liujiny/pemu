index 0000000..1a60b2d
--- /dev/null
+++ b/source/skeleton/ps5_profiler.cpp
@@ -0,0 +1,71 @@
+#include "cross2d/skeleton/ps5_profiler.h"
+
+#if defined(__PS5__)
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+namespace {
+using Clock = std::chrono::steady_clock;
+double now() { return std::chrono::duration<double, std::milli>(Clock::now().time_since_epoch()).count(); }
+double totals[7] = {};
+double started[7] = {};
+double current[7] = {};
+double minimum[7] = {};
+double maximum[7] = {};
+unsigned long frames = 0;
+unsigned int windowFrames = 0;
+int gameW = 0, gameH = 0, pitch = 0, displayW = 0, displayH = 0;
+const char *format = "unknown";
+const char *shader = "none";
+const char *mode() {
+    const char *value = std::getenv("PEMU_CRT_MODE");
+    if (!value || !*value) return "CRT_CURRENT";
+    if (!std::strcmp(value, "CRT_OFF") || !std::strcmp(value, "CRT_TEST_FAST") ||
+        !std::strcmp(value, "CRT_CURRENT")) return value;
+    return "CRT_CURRENT";
+}
+}
+
+namespace c2d { namespace PS5Profiler {
+void beginFrame() {
+    ++frames;
+    ++windowFrames;
+    std::memset(current, 0, sizeof(current));
+    begin(Frame);
+}
+void begin(Stage stage) { started[stage] = now(); }
+void end(Stage stage) { if (started[stage] > 0) { current[stage] += now() - started[stage]; started[stage] = 0; } }
+void setGameInfo(int w, int h, int p, const char *f) { gameW=w; gameH=h; pitch=p; format=f; }
+void setShader(const char *s) { shader = s ? s : "none"; }
+void setDisplaySize(int w, int h) { displayW=w; displayH=h; }
+void endFrame() {
+    end(Frame);
+    for (int i = 0; i < 7; ++i) {
+        totals[i] += current[i];
+        if (windowFrames == 1 || current[i] < minimum[i]) minimum[i] = current[i];
+        if (current[i] > maximum[i]) maximum[i] = current[i];
+    }
+    if (windowFrames < 120) return;
+    const double frameAvg = totals[Frame] / windowFrames;
+    std::printf("[PS5 PERF %uf] fps=%.2f core=%.3fms upload=%.3fms video=%.3fms ui=%.3fms present=%.3fms frame=%.3fms frame_min=%.3fms frame_max=%.3fms shader=%s src=%dx%d pitch=%d display=%dx%d\n",
+        windowFrames, frameAvg > 0 ? 1000.0 / frameAvg : 0.0, totals[Core]/windowFrames,
+        totals[Upload]/windowFrames, totals[VideoDraw]/windowFrames, totals[UIDraw]/windowFrames,
+        totals[Present]/windowFrames, frameAvg, minimum[Frame], maximum[Frame], shader,
+        gameW, gameH, pitch, displayW, displayH);
+    std::printf("[PS5 PERF %uf] crt=%s crt_avg=%.3fms crt_min=%.3fms crt_max=%.3fms\n",
+        windowFrames, std::strcmp(shader, "c2d-texture") == 0 ? "off" : shader,
+        totals[CRTDraw]/windowFrames, minimum[CRTDraw], maximum[CRTDraw]);
+    std::printf("PS5_VIDEO framebuffer=%dx%d pitch=%d format=%s display=%dx%d shader=%s mode=%s\n",
+        gameW, gameH, pitch, format, displayW, displayH, shader, mode());
+    std::memset(totals, 0, sizeof(totals));
+    windowFrames = 0;
+}
+} }
+#else
+namespace c2d { namespace PS5Profiler {
+void beginFrame() {} void begin(Stage) {} void end(Stage) {} void endFrame() {}
+void setGameInfo(int,int,int,const char*) {} void setShader(const char*) {} void setDisplaySize(int,int) {}
+} }
+#endif
