+#if defined(__PS5__)
+void SDL2Audio::fillBufferedAudio(Uint8 *stream, int len) {
+    memset(stream, 0, len);
+    const int wanted = len / (int)sizeof(int16_t);
+    lock();
+    const int queued = getSampleBufferQueued();
+    // Two emulated frames (~33 ms at 60Hz) absorb a short late frame.
+    // Also require one full callback block before the first pull.
+    const int reserve = getSamples() * getChannels() * 2;
+    if (m_priming && queued < (wanted > reserve ? wanted : reserve)) {
+        unlock();
+        return;
+    }
+    m_priming = false;
+    int available = queued < wanted ? queued : wanted;
+    available -= available % getChannels();
+    if (available) getSampleBuffer()->pull((int16_t *)stream, available);
+    if (available < wanted) m_priming = true;
+    unlock();
+}
+#endif
