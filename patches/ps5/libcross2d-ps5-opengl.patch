diff --git a/include/cross2d/platforms/gl2/ps5_scanout_shader.h b/include/cross2d/platforms/gl2/ps5_scanout_shader.h
new file mode 100644
index 0000000..03f3ac0
--- /dev/null
+++ b/include/cross2d/platforms/gl2/ps5_scanout_shader.h
@@ -0,0 +1,20 @@
+// PS5 native G19 scanout compatibility: its RGBA render target is registered
+// with the system BGRA display format. Encode only the default framebuffer.
+#pragma once
+#include <string>
+namespace c2d {
+inline std::string ps5ScanoutFragment(std::string source) {
+    const char *output = source.find("out vec4 fragColor") != std::string::npos ? "fragColor" :
+                         (source.find("out vec4 FragColor") != std::string::npos || source.find("#define FragColor") != std::string::npos) ? "FragColor" : "gl_FragColor";
+    const auto versionEnd = source.find('\n');
+    if (versionEnd == std::string::npos) return source;
+    source.insert(versionEnd + 1, "#define main pemu_fragment_main\n");
+    source += "\n#undef main\nuniform int pemu_bgra_scanout;\nvoid main() {\n"
+              "pemu_fragment_main();\nif (pemu_bgra_scanout != 0) ";
+    source += output;
+    source += " = ";
+    source += output;
+    source += ".bgra;\n}\n";
+    return source;
+}
+}
diff --git a/include/cross2d/platforms/gl2/ps5_triangles.h b/include/cross2d/platforms/gl2/ps5_triangles.h
new file mode 100644
index 0000000..d53c4f8
--- /dev/null
+++ b/include/cross2d/platforms/gl2/ps5_triangles.h
@@ -0,0 +1,26 @@
+// pEMU PS5: upload fan/strip geometry as equivalent triangle lists.
+#pragma once
+#include <cstddef>
+#include <vector>
+#include "cross2d/skeleton/sfml/PrimitiveType.hpp"
+namespace c2d {
+inline bool ps5TriangleList(PrimitiveType type) {
+    return type == TriangleStrip || type == TriangleFan;
+}
+inline std::size_t ps5TriangleVertexCount(PrimitiveType type, std::size_t count) {
+    return ps5TriangleList(type) ? (count < 3 ? 0 : (count - 2) * 3) : count;
+}
+template<class VertexType>
+void ps5ExpandTriangles(const std::vector<VertexType> &src, PrimitiveType type,
+                       std::vector<VertexType> &dst) {
+    dst.clear();
+    if (!ps5TriangleList(type)) { dst = src; return; }
+    dst.reserve(ps5TriangleVertexCount(type, src.size()));
+    for (std::size_t i = 0; i + 2 < src.size(); ++i) {
+        // Preserve winding, primitive order, degenerates and last provoking vertex.
+        const std::size_t a = type == TriangleFan ? 0 : i + (i & 1);
+        const std::size_t b = type == TriangleFan ? i + 1 : i + 1 - (i & 1);
+        dst.push_back(src[a]); dst.push_back(src[b]); dst.push_back(src[i + 2]);
+    }
+}
+}
