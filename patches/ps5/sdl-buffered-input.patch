+/* Altered for pEMU native: preserve short presses between frame polls.
+ * The native RetroArch input port uses this 120-byte, 64-sample ABI too. */
+extern int scePadRead(int handle, void *samples, int capacity);
+_Static_assert(sizeof(PS5_PadData) == 120, "pad sample stride");
+_Static_assert(offsetof(PS5_PadData, timestamp) == 0x50, "pad timestamp offset");
+
+static void PS5_JoystickUpdate(SDL_Joystick *joystick)
+{
+    PS5_PadContext *ctx = PS5_JoystickGetPadContext(joystick);
+    PS5_PadData samples[64];
+    if (!ctx) return;
+    int count = scePadRead(ctx->handle, samples, SDL_arraysize(samples));
+    if (count < 0 || count > SDL_arraysize(samples)) {
+        /* Keep the established state reader available on service errors. */
+        if (scePadReadState(ctx->handle, samples) != 0) return;
+        count = 1;
+    }
+    /* Do not assume the service's batch order. Stable chronological replay
+     * leaves SDL's live state at the newest sample and queues every edge. */
+    for (int i = 1; i < count; ++i) {
+        PS5_PadData sample = samples[i];
+        int j = i;
+        while (j > 0 && samples[j-1].timestamp > sample.timestamp) {
+            samples[j] = samples[j-1];
+            --j;
+        }
+        samples[j] = sample;
+    }
+    for (int i = 0; i < count; ++i)
+        PS5_PublishPad(joystick, ctx, &samples[i]);
 }
 
